{
    "name": "markshust/magento2-module-ordergrid",
    "description": "The Order Grid module adds more details to the order grid in the admin.",
    "require": {
        "php": "^8",
        "magento/framework": "^101|^102|^103"
    },
    "type": "magento2-module",
    "version": "3.0.0",
    "license": [
        "MIT"
    ],
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "MarkShust\\OrderGrid\\": ""
        }
    },
    "require-dev": {
        "magento/magento-coding-standard": "^41",
        "phpstan/phpstan": "^2.1",
        "bitexpert/phpstan-magento": "^0.44",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
